#!/usr/bin/env bash
# ShellCheck 0.11.0 reports SC2218 for calls placed before a later `$(function)` call,
# though every function is defined before main runs (koalaman/shellcheck#3290).
# SC2030/SC2031: relay_entries loads each instance in a subshell on purpose, so
# the instance being deployed keeps its own settings.
# shellcheck disable=SC2218,SC2030,SC2031
# rhodes-hangar: headless Android instances running Arknights, each with a La
# Pluma MAA web console. One instance = data/<name>/ + its compose project.
set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
# A new tag whenever image/ changes, so deploy builds it and moves instances over.
IMAGE=local/rhodes-hangar-redroid:14-avd34-c2
REDROID_BASE=redroid/redroid@sha256:a3e654caad74faed03cd5ead057a989e06f507778cda678e5d3b9772e0092f1c
# ER5TT/ndk 9ecefe66 (Google AVD 34 ext12 r01 ARM translation); codeload serves this tarball byte for byte.
NDK_URL=https://codeload.github.com/ER5TT/ndk/tar.gz/9ecefe66bb78e3347bbac7d2237befebd0552c15
NDK_SHA256=c18361e92be742d2b2e21f075081ca7cba97fbb4d251f8e3ff7bf04ad9bb1f65
BOOT_TIMEOUT_S=240
# The Bilibili package CDN answers 403 to curl's and bare browser user agents; it serves
# Android's download manager. The official CDN accepts it too.
APK_UA='Dalvik/2.1.0 (Linux; U; Android 14)'
# The shared relay (relay.compose.yaml) every instance with --public-ip advertises.
RELAY_PORT=3478
RELAY_DIR=$ROOT/data/relay

usage() {
	cat <<'EOF'
usage: hangar COMMAND [-i INSTANCE] [options]

  deploy        Build the image if missing, create or update the instance, start it,
                install or update Arknights, and check that La Pluma reaches Android.
                  --server official|bilibili   game server (new instance default: official)
                  --web-port N                 web console port (new instance default: 13055)
                  --bind ADDR                  web console listen address: 127.0.0.1 (default),
                                               0.0.0.0 for every interface, or one IPv4 address
                  --public-ip ADDR|none        the IPv4 address or domain name other machines
                                               reach this host at; lets their browsers show the
                                               live preview (default: the --bind address when
                                               it is one). A domain is resolved now and by
                                               refresh-ip; La Pluma itself takes only an address
                  --adb-bind ADDR|none         publish adb outside the compose network:
                                               none (default), 127.0.0.1, or another address
                  --adb-port N                 adb host port when published (default: 15556)
                  --gpu-node PATH              render node (default: /dev/dri/renderD129)
  install-game  Install or update Arknights on a running instance.
  up | down     Start or stop an instance.
  status        Containers, game version and La Pluma's connection check.
  service       The systemd user service that runs `hangar up` for the instance at boot
                (deploy installs it; `down` does not stop the next boot from starting it).
                  --install | --uninstall | --status
  refresh-ip    Resolve the --public-ip domain again; when its address moved, restart
                La Pluma with it (not while MAA is running). deploy installs a systemd
                user timer that runs it every 5 minutes while --public-ip is a domain.
  screen        Mirror the instance with scrcpy (needs --adb-bind; audio off: this
                Android has no opus encoder).

INSTANCE defaults to "main". Web console: http://<bind>:<web-port>, token in
data/<instance>/instance.env.
EOF
}

die() { printf 'hangar: %s\n' "$*" >&2; exit 1; }
step() { printf '\033[1m==> %s\033[0m\n' "$*"; }

need() {
	local c
	for c in "$@"; do command -v "$c" >/dev/null || die "$c is required"; done
}

# ---- instance configuration ----

instance=main
server=""
web_port=""
adb_port=""
gpu_node=""
bind=""
public_ip=""
adb_bind=""
service_action=""

parse_opts() {
	while (($#)); do
		case $1 in
		-i | --instance) instance=${2:?}; shift ;;
		--server) server=${2:?}; shift ;;
		--web-port) web_port=${2:?}; shift ;;
		--adb-port) adb_port=${2:?}; shift ;;
		--gpu-node) gpu_node=${2:?}; shift ;;
		--bind) bind=${2:?}; shift ;;
		--public-ip) public_ip=${2:?}; shift ;;
		--adb-bind) adb_bind=${2:?}; shift ;;
		--install | --uninstall | --status) service_action=${1#--} ;;
		-h | --help) usage; exit 0 ;;
		*) die "unknown option: $1" ;;
		esac
		shift
	done
	[[ $instance =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]] || die "instance names use a-z, 0-9 and -"
	[[ $instance != relay ]] || die "\"relay\" is taken: data/relay holds the shared relay"
	case $server in "" | official | bilibili) ;; *) die "--server is official or bilibili" ;; esac
	DATA=$ROOT/data/$instance
	ENV_FILE=$DATA/instance.env
	PROJECT=rhodes-hangar-$instance
}

# A dotted IPv4 address, each part 0-255 without leading zeros.
is_ipv4() {
	local IFS=. part
	local -a parts
	[[ $1 =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
	read -ra parts <<<"$1"
	for part in "${parts[@]}"; do
		[[ $part =~ ^(0|[1-9][0-9]*)$ ]] && ((part <= 255)) || return 1
	done
}

client_of() { [[ $1 == bilibili ]] && echo Bilibili || echo Official; }

# instance.env is read by this script and by `docker compose --env-file`, which
# interpolates `$`. Every value is held to characters neither treats specially.
check_field() {
	local key=$1 value=$2 ok=""
	case $key in
	HANGAR_INSTANCE) [[ $value =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]] && ok=1 ;;
	HANGAR_CLIENT_TYPE) [[ $value == Official || $value == Bilibili ]] && ok=1 ;;
	HANGAR_WEB_PORT | HANGAR_ADB_PORT) [[ $value =~ ^[1-9][0-9]{0,4}$ ]] && ((value <= 65535)) && ok=1 ;;
	HANGAR_BIND) is_ipv4 "$value" && ok=1 ;;
	HANGAR_PUBLIC_IP) [[ -z $value ]] || is_public_ipv4 "$value" && ok=1 ;;
	HANGAR_PUBLIC_ADDR) [[ -z $value ]] || is_public_ipv4 "$value" || is_hostname "$value" && ok=1 ;;
	HANGAR_ADB_BIND) [[ $value == none ]] || is_ipv4 "$value" && ok=1 ;;
	HANGAR_GPU_NODE) [[ $value =~ ^/dev/dri/[A-Za-z0-9_]+$ ]] && ok=1 ;;
	LA_PLUMA_TOKEN) [[ $value =~ ^[A-Za-z0-9._~+/=-]{16,256}$ ]] && ok=1 ;;
	HANGAR_TURN_PASSWORD) [[ $value =~ ^[A-Za-z0-9]{16,64}$ ]] && ok=1 ;;
	COMPOSE_FILE) [[ $value == compose.yaml || $value == compose.yaml:compose.adb.yaml ]] && ok=1 ;;
	*) die "$ENV_FILE: unknown setting $key" ;;
	esac
	[[ -n $ok ]] && return 0
	case $key in
	LA_PLUMA_TOKEN) die "LA_PLUMA_TOKEN must be 16-256 characters of A-Z a-z 0-9 . _ ~ + / = -" ;;
	HANGAR_GPU_NODE) die "the GPU node must look like /dev/dri/renderD129, not: $value" ;;
	HANGAR_PUBLIC_IP) die "the public IP is an IPv4 address other machines reach this host at, not: $value" ;;
	HANGAR_PUBLIC_ADDR) die "--public-ip takes an IPv4 address or a domain name other machines reach this host at, not: $value" ;;
	HANGAR_ADB_BIND) die "the adb address is none or an IPv4 address, not: $value" ;;
	*) die "invalid $key: $value" ;;
	esac
}

ENV_KEYS=(HANGAR_INSTANCE HANGAR_CLIENT_TYPE HANGAR_BIND HANGAR_WEB_PORT HANGAR_PUBLIC_ADDR HANGAR_PUBLIC_IP
	HANGAR_ADB_BIND HANGAR_ADB_PORT HANGAR_GPU_NODE LA_PLUMA_TOKEN HANGAR_TURN_PASSWORD COMPOSE_FILE)

random_hex() { od -An -tx1 -N"$1" /dev/urandom | tr -d ' \n'; }

# An address other machines can be told to reach: not a wildcard or loopback.
is_public_ipv4() { is_ipv4 "$1" && [[ $1 != 0.0.0.0 && $1 != 127.* ]]; }

# A DNS name of letters, digits and hyphens with at least one dot, as DDNS hands out.
is_hostname() {
	((${#1} <= 253)) && [[ $1 =~ ^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$ ]]
}

# The IPv4 address a public resolver gives for a name, following CNAMEs. DNS over
# HTTPS, as the system resolver may answer with a proxy's fake address (Mihomo's
# fake-ip range, 198.18.0.0/15).
resolve_ipv4() {
	local url ip
	for url in "https://dns.alidns.com/resolve?name=$1&type=A" "https://cloudflare-dns.com/dns-query?name=$1&type=A"; do
		ip=$(curl -fsS --max-time 10 -H 'accept: application/dns-json' "$url" 2>/dev/null |
			jq -r '[.Answer[]? | select(.type == 1) | .data] | last // empty' 2>/dev/null) || ip=""
		if [[ -n $ip ]] && is_public_ipv4 "$ip"; then
			printf '%s\n' "$ip"
			return 0
		fi
	done
	return 1
}

# Values that follow from the settings, written out for plain `docker compose`.
derive() {
	COMPOSE_FILE=compose.yaml
	if [[ $HANGAR_ADB_BIND != none ]]; then
		COMPOSE_FILE=compose.yaml:compose.adb.yaml
	fi
}

# Writes instance.env from the current values; the token never leaves the file.
write_env() {
	local key
	HANGAR_INSTANCE=$instance
	derive
	for key in "${ENV_KEYS[@]}"; do check_field "$key" "${!key}"; done
	mkdir -p "$DATA"
	umask 077
	{
		printf '# rhodes-hangar instance "%s". Edit, then run: ./hangar deploy -i %s\n' "$instance" "$instance"
		for key in "${ENV_KEYS[@]}"; do printf '%s=%s\n' "$key" "${!key}"; done
	} >"$ENV_FILE.tmp"
	mv "$ENV_FILE.tmp" "$ENV_FILE"
	# Plain `docker compose` in the project directory then manages the main instance.
	if [[ $instance == main ]]; then
		ln -sfn data/main/instance.env "$ROOT/.env"
	fi
}

# Reads instance.env as data: known keys only, each value checked, nothing executed.
# `upgrading` accepts a file from an older hangar that deploy is about to rewrite.
load_env() {
	[[ -f $ENV_FILE ]] || die "no instance \"$instance\"; create it with: ./hangar deploy -i $instance"
	local key value line upgrading=${1:-}
	for key in "${ENV_KEYS[@]}"; do unset "$key"; done
	while IFS= read -r line || [[ -n $line ]]; do
		[[ -z $line || $line == \#* ]] && continue
		[[ $line == *=* ]] || die "$ENV_FILE: not KEY=VALUE: $line"
		key=${line%%=*} value=${line#*=}
		# Each instance published its own relay port before the shared relay.
		[[ $key == HANGAR_TURN_BIND ]] && continue
		check_field "$key" "$value"
		printf -v "$key" '%s' "$value"
	done <"$ENV_FILE"
	# Settings added after the first release keep their defaults when absent.
	HANGAR_BIND=${HANGAR_BIND:-127.0.0.1}
	HANGAR_PUBLIC_IP=${HANGAR_PUBLIC_IP:-}
	# Before domains were accepted, the address was the setting itself.
	[[ -v HANGAR_PUBLIC_ADDR ]] || HANGAR_PUBLIC_ADDR=$HANGAR_PUBLIC_IP
	HANGAR_ADB_BIND=${HANGAR_ADB_BIND:-none}
	derive
	if [[ -z ${HANGAR_TURN_PASSWORD:-} && -n $upgrading ]]; then
		HANGAR_TURN_PASSWORD=$(random_hex 16)
	fi
	for key in "${ENV_KEYS[@]}"; do
		[[ $key == HANGAR_PUBLIC_IP || $key == HANGAR_PUBLIC_ADDR || -n ${!key:-} ]] && continue
		[[ $key == HANGAR_TURN_PASSWORD ]] && die "$ENV_FILE is from an older hangar; run: ./hangar deploy -i $instance"
		die "$ENV_FILE: $key is missing"
	done
	[[ $HANGAR_INSTANCE == "$instance" ]] || die "$ENV_FILE belongs to instance $HANGAR_INSTANCE"
	# This script reaches the console locally; 0.0.0.0 includes the loopback address.
	WEB=http://$(local_addr "$HANGAR_BIND"):$HANGAR_WEB_PORT
	SERIAL=""
	if [[ $HANGAR_ADB_BIND != none ]]; then
		SERIAL=$(local_addr "$HANGAR_ADB_BIND"):$HANGAR_ADB_PORT
	fi
	if [[ $HANGAR_CLIENT_TYPE == Bilibili ]]; then
		PKG=com.hypergryph.arknights.bilibili
	else
		PKG=com.hypergryph.arknights
	fi
}

local_addr() { [[ $1 == 0.0.0.0 ]] && echo 127.0.0.1 || echo "$1"; }

# Creates the instance on first deploy with defaults; every deploy applies the options given.
configure_instance() {
	if [[ -f $ENV_FILE ]]; then
		load_env upgrading
	else
		step "Creating instance \"$instance\""
		HANGAR_CLIENT_TYPE=Official
		HANGAR_WEB_PORT=13055
		HANGAR_BIND=127.0.0.1
		HANGAR_PUBLIC_ADDR=""
		HANGAR_ADB_BIND=none
		HANGAR_ADB_PORT=15556
		HANGAR_GPU_NODE=/dev/dri/renderD129
		# A token in the environment is kept, as when moving an existing console here.
		LA_PLUMA_TOKEN=${LA_PLUMA_TOKEN:-$(random_hex 24)}
		HANGAR_TURN_PASSWORD=$(random_hex 16)
	fi
	if [[ -n $server ]]; then
		HANGAR_CLIENT_TYPE=$(client_of "$server")
	fi
	HANGAR_WEB_PORT=${web_port:-$HANGAR_WEB_PORT}
	HANGAR_BIND=${bind:-$HANGAR_BIND}
	HANGAR_ADB_BIND=${adb_bind:-$HANGAR_ADB_BIND}
	HANGAR_ADB_PORT=${adb_port:-$HANGAR_ADB_PORT}
	HANGAR_GPU_NODE=${gpu_node:-$HANGAR_GPU_NODE}
	if [[ $public_ip == none ]]; then
		HANGAR_PUBLIC_ADDR=""
	elif [[ -n $public_ip ]]; then
		HANGAR_PUBLIC_ADDR=$public_ip
	elif [[ $bind == 127.* ]]; then
		# Back to this machine only: the relay closes with the console.
		HANGAR_PUBLIC_ADDR=""
	elif [[ -n $bind && $bind != 0.0.0.0 ]]; then
		# Listening on one address: browsers elsewhere reach this host there.
		HANGAR_PUBLIC_ADDR=$bind
	fi
	check_field HANGAR_PUBLIC_ADDR "$HANGAR_PUBLIC_ADDR"
	if is_hostname "$HANGAR_PUBLIC_ADDR"; then
		HANGAR_PUBLIC_IP=$(resolve_ipv4 "$HANGAR_PUBLIC_ADDR") || die "could not resolve $HANGAR_PUBLIC_ADDR to an IPv4 address"
	else
		HANGAR_PUBLIC_IP=$HANGAR_PUBLIC_ADDR
	fi
	# Checked before anything is created, so a bad value leaves nothing behind.
	write_env
	mkdir -p "$DATA"/android "$DATA"/la-pluma/{data,maa-config/profiles,maa-data}
	load_env
}

# maa-cli's connection profile: La Pluma runs MAA against it. redroid needs the
# POSIX shell adb config, and MaaTouch for input.
write_maa_profile() {
	local dir=$DATA/la-pluma/maa-config
	mkdir -p "$dir/profiles"
	cat >"$dir/profiles/default.toml.tmp" <<'EOF'
# Written by hangar deploy: MAA's connection to this instance's Android.
[connection]
adb_path = "/usr/bin/adb"
address = "android:5555"
config = "CompatPOSIXShell"

[instance_options]
touch_mode = "MaaTouch"
kill_adb_on_exit = false
EOF
	mv "$dir/profiles/default.toml.tmp" "$dir/profiles/default.toml"
	[[ -f $dir/cli.toml ]] || cat >"$dir/cli.toml" <<'EOF'
# Fetch MAA's official hot-update files directly from MaaRelease.
[hot_update]
api_url = "https://raw.githubusercontent.com/MaaAssistantArknights/MaaRelease/main/MaaAssistantArknights/api"
EOF
	return 0
}

compose() {
	local files=() f
	IFS=: read -ra files <<<"$COMPOSE_FILE"
	local args=(--project-directory "$ROOT" --env-file "$ENV_FILE")
	for f in "${files[@]}"; do args+=(-f "$ROOT/$f"); done
	docker compose "${args[@]}" "$@"
}

# ---- shared relay ----

relay_compose() {
	# --env-file /dev/null: the project directory's .env belongs to the main instance.
	HANGAR_UID=$(id -u) HANGAR_GID=$(id -g) docker compose --project-directory "$ROOT" \
		--env-file /dev/null -f "$ROOT/relay.compose.yaml" "$@"
}

# The relay's user and allowed peer for every instance with --public-ip: its La
# Pluma container's address alone. Not the whole compose network, whose gateway
# is this host and which holds Android; and the allow list is shared by all
# users, so a wider one would let one instance's credentials reach the others.
relay_entries() {
	local env name ip
	for env in "$ROOT"/data/*/instance.env; do
		[[ -f $env ]] || continue
		name=$(basename "$(dirname "$env")")
		(
			instance=$name DATA=$ROOT/data/$name ENV_FILE=$env
			load_env
			[[ -n $HANGAR_PUBLIC_ADDR ]] || exit 0
			printf 'user=hangar-%s:%s\n' "$instance" "$HANGAR_TURN_PASSWORD"
			for ip in $(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}}' "rhodes-hangar-${instance}-la-pluma-1" 2>/dev/null); do
				is_ipv4 "$ip" && printf 'allowed-peer-ip=%s\n' "$ip"
			done
			exit 0
		)
	done
}

# Writes the relay's configuration from every instance and starts, restarts or
# stops it to match. Runs after the instance's containers exist (their network).
sync_relay() {
	local entries relay_ip conf old="" file=$RELAY_DIR/turnserver.conf
	entries=$(relay_entries)
	if [[ -z $entries ]]; then
		[[ -f $file ]] || return 0
		relay_compose down >/dev/null 2>&1 || true
		rm -f "$file"
		step "Stopped the shared relay: no instance has --public-ip"
		return 0
	fi
	# The relay's own end: a host address every instance network reaches.
	relay_ip=$(ip -4 -o addr show docker0 2>/dev/null | awk '{ sub(/\/.*/, "", $4); print $4; exit }')
	[[ -n $relay_ip ]] || die "docker0 has no IPv4 address for the relay's own end"
	conf=$(
		cat <<EOF
# Written by hangar from data/*/instance.env; do not edit.
listening-port=$RELAY_PORT
realm=rhodes-hangar
fingerprint
lt-cred-mech
no-tcp
no-tls
no-dtls
relay-ip=$relay_ip
min-port=49160
max-port=49260
pidfile=/tmp/turnserver.pid
log-file=stdout
# Relay to the instances' La Pluma only, never into the LAN or the internet.
denied-peer-ip=0.0.0.0-255.255.255.255
denied-peer-ip=::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
EOF
		printf '%s\n' "$entries"
	)
	mkdir -p "$RELAY_DIR"
	chmod 700 "$RELAY_DIR"
	[[ -f $file ]] && old=$(<"$file")
	if [[ $conf != "$old" ]]; then
		(umask 077 && printf '%s\n' "$conf" >"$file.tmp" && mv "$file.tmp" "$file")
		relay_compose up -d --force-recreate --quiet-pull >/dev/null
		step "Shared relay on UDP $RELAY_PORT updated (rhodes-hangar-relay)"
	else
		relay_compose up -d --quiet-pull >/dev/null
	fi
}

# ---- image ----

ensure_image() {
	docker image inspect "$IMAGE" >/dev/null 2>&1 && return
	step "Building $IMAGE"
	local tgz=$ROOT/image/ndk34.tgz
	if ! echo "$NDK_SHA256  $tgz" | sha256sum -c --quiet - 2>/dev/null; then
		curl -fL --retry 3 -o "$tgz.part" "$NDK_URL"
		echo "$NDK_SHA256  $tgz.part" | sha256sum -c --quiet - || die "ndk34.tgz checksum mismatch"
		mv "$tgz.part" "$tgz"
	fi
	docker build --target avd34 --build-arg "REDROID=$REDROID_BASE" -t "$IMAGE" "$ROOT/image"
}

# ---- Android ----

# A command in Android, run through the container: adb need not leave the compose network.
android() { compose exec -T android "$@"; }

wait_boot() {
	step "Waiting for Android to boot"
	local deadline=$((SECONDS + BOOT_TIMEOUT_S))
	until [[ $(android getprop sys.boot_completed 2>/dev/null | tr -d '\r') == 1 ]]; do
		((SECONDS < deadline)) || die "Android did not boot within ${BOOT_TIMEOUT_S}s (see: ./hangar status -i $instance)"
		sleep 3
	done
}

# Reads all of dumpsys's output: stopping early makes it fail with a broken pipe.
installed_version() {
	android dumpsys package "$PKG" 2>/dev/null | tr -d '\r' | awk -F= '/^ *versionName=/ && v == "" { v = $2 } END { print v }'
}

latest_version() {
	local channel=official
	[[ $HANGAR_CLIENT_TYPE == Bilibili ]] && channel=b
	curl -fsS --max-time 20 "https://ak-conf.hypergryph.com/config/prod/$channel/Android/version" | jq -r .clientVersion
}

apk_url() {
	if [[ $HANGAR_CLIENT_TYPE == Bilibili ]]; then
		curl -fsS --max-time 20 'https://line1-h5-pc-api.biligame.com/game/detail/gameinfo?game_base_id=101772' | jq -er .data.android_download_link
	else
		# The launcher refuses HEAD; a one-byte GET follows the redirects to the CDN file.
		curl -fsSL --max-time 30 -A "$APK_UA" -r 0-0 -o /dev/null -w '%{url_effective}' https://ak.hypergryph.com/downloads/android_lastest
	fi
}

# Downloads the APK into cache/ (resumable), checks its size and zip header.
fetch_apk() {
	local url=$1 file total
	mkdir -p "$ROOT/cache"
	file=$ROOT/cache/$(basename "${url%%\?*}")
	total=$(curl -fsSL --max-time 30 -A "$APK_UA" -r 0-0 -D - -o /dev/null "$url" | tr -d '\r' | sed -n 's/^content-range: bytes 0-0\///Ip' | tail -1)
	[[ $total =~ ^[0-9]+$ ]] || die "could not read the APK size from $url"
	if [[ ! -f $file || $(stat -c %s "$file") != "$total" ]]; then
		printf '%s\n' "Downloading $(basename "$file") ($((total / 1048576)) MiB)" >&2
		curl -fL --retry 5 -A "$APK_UA" -C - -o "$file" "$url" >&2
	fi
	[[ $(stat -c %s "$file") == "$total" ]] || die "incomplete download: $file"
	[[ $(head -c 2 "$file") == PK ]] || die "not an APK: $file"
	# Keep only the current package of each server.
	find "$ROOT/cache" -maxdepth 1 -name '*.apk' ! -name "$(basename "$file")" \
		-name "$( [[ $HANGAR_CLIENT_TYPE == Bilibili ]] && echo 'mrfz_*' || echo 'arknights-hg-*')" -delete
	printf '%s\n' "$file"
}

install_game() {
	local have want url apk size
	have=$(installed_version)
	want=$(latest_version) || die "could not read the latest Arknights version"
	if [[ -n $have && $have == "$want" ]]; then
		step "Arknights $have ($PKG) is up to date"
		return
	fi
	step "Installing Arknights $want ($HANGAR_CLIENT_TYPE${have:+, replacing $have})"
	url=$(apk_url) || die "could not find the APK download"
	apk=$(fetch_apk "$url")
	# The game ships ARM code only; the translation layer runs it on x86_64.
	# pm reads the package from stdin, streamed through the container.
	size=$(stat -c %s "$apk")
	android pm install -r --abi arm64-v8a -S "$size" <"$apk"
	[[ $(installed_version) == "$want" ]] || die "after install the version is $(installed_version), not $want"
	[[ -z $have ]] && first_install=1
	return 0
}

# ---- La Pluma ----

lapluma() { curl -fsS --max-time 30 -H "X-La-Pluma-Token: $LA_PLUMA_TOKEN" "$@"; }

check_console() {
	step "Checking La Pluma at $WEB"
	local deadline=$((SECONDS + 120)) r
	until curl -fsS --max-time 5 "$WEB/health" >/dev/null 2>&1; do
		((SECONDS < deadline)) || die "La Pluma did not answer at $WEB/health"
		sleep 2
	done
	r=$(lapluma -X POST -H 'Content-Type: application/json' -d '{}' "$WEB/api/agent/actions/test-connection") ||
		die "La Pluma's connection check failed"
	jq -e '.data.connected == true' <<<"$r" >/dev/null || die "La Pluma cannot reach Android: $(jq -r .message <<<"$r")"
	printf '    %s (client: %s)\n' "$(jq -r .message <<<"$r")" \
		"$(lapluma "$WEB/api/agent/status" | jq -r .data.connection.clientType)"
}

# ---- commands ----

cmd_deploy() {
	need docker curl jq sha256sum
	configure_instance
	ensure_image
	write_maa_profile
	step "Starting $PROJECT"
	compose up -d --remove-orphans
	sync_relay
	wait_boot
	install_game
	check_console
	sync_timer
	install_service
	printf '\nInstance "%s" is ready.\n' "$instance"
	printf '  Web console   %s   (token: LA_PLUMA_TOKEN in data/%s/instance.env)\n' "$WEB" "$instance"
	if is_hostname "$HANGAR_PUBLIC_ADDR"; then
		printf '  Live preview  from other machines through %s, now %s (shared relay: UDP %s;\n' \
			"$HANGAR_PUBLIC_ADDR" "$HANGAR_PUBLIC_IP" "$RELAY_PORT"
		printf '                the address is checked every 5 minutes)\n'
	elif [[ -n $HANGAR_PUBLIC_IP ]]; then
		printf '  Live preview  from other machines at %s (shared relay: UDP %s)\n' "$HANGAR_PUBLIC_IP" "$RELAY_PORT"
	elif [[ $HANGAR_BIND != 127.0.0.1 ]]; then
		printf '  Live preview  this machine only: add --public-ip ADDR for browsers elsewhere\n'
	fi
	if [[ -n $SERIAL ]]; then
		printf '  adb           %s, or ./hangar screen -i %s\n' "$SERIAL" "$instance"
	else
		printf '  adb           inside the compose network only (--adb-bind 127.0.0.1 publishes it)\n'
	fi
	if [[ $HANGAR_BIND == 0.0.0.0 ]]; then
		printf '  The web console listens on every interface (port %s); only its token protects it.\n' "$HANGAR_WEB_PORT"
	fi
	if [[ $HANGAR_ADB_BIND != none && $HANGAR_ADB_BIND != 127.* ]]; then
		printf '  adb listens on %s with no authentication: a root shell in a privileged container.\n' "$HANGAR_ADB_BIND"
	fi
	if [[ -n ${first_install:-} ]]; then
		printf '  Open the game once and log in: it downloads ~12 GB of resources on first launch.\n'
	fi
	return 0
}

cmd_status() {
	need docker curl jq
	load_env
	compose ps
	printf '\nArknights (%s): %s\n' "$PKG" "$(installed_version || true)"
	check_console || true
}

# Whether La Pluma is running MAA now; restarting it would cut the run off.
console_busy() {
	lapluma "$WEB/api/agent/runs/current?lines=0" 2>/dev/null |
		jq -e '.data | .isRunning or .schedule.isRunning or .task.isRunning or ((.lease.state // "free") != "free")' >/dev/null
}

cmd_refresh_ip() {
	need docker curl jq
	load_env
	if ! is_hostname "$HANGAR_PUBLIC_ADDR"; then
		printf 'Instance "%s" has no --public-ip domain; nothing to resolve.\n' "$instance"
		return 0
	fi
	local ip
	ip=$(resolve_ipv4 "$HANGAR_PUBLIC_ADDR") || die "could not resolve $HANGAR_PUBLIC_ADDR to an IPv4 address"
	if [[ $ip == "$HANGAR_PUBLIC_IP" ]]; then
		printf '%s is still %s.\n' "$HANGAR_PUBLIC_ADDR" "$ip"
		return 0
	fi
	if [[ -z $(compose ps -q --status running la-pluma 2>/dev/null) ]]; then
		HANGAR_PUBLIC_IP=$ip
		write_env
		printf '%s moved to %s; La Pluma is not running and starts with it.\n' "$HANGAR_PUBLIC_ADDR" "$ip"
		return 0
	fi
	# The settings stay as they were, so the next check tries again.
	if console_busy; then
		printf '%s moved to %s, but MAA is running; La Pluma restarts at a later check.\n' "$HANGAR_PUBLIC_ADDR" "$ip"
		return 0
	fi
	step "$HANGAR_PUBLIC_ADDR moved from $HANGAR_PUBLIC_IP to $ip; restarting La Pluma"
	HANGAR_PUBLIC_IP=$ip
	write_env
	compose up -d la-pluma
	# A recreated container may have a new address on its network.
	sync_relay
	check_console
}

timer_unit() { printf 'rhodes-hangar-refresh-ip-%s' "$instance"; }

# A domain for --public-ip gets a systemd user timer that runs refresh-ip every 5
# minutes; an address or none removes it. Without a user systemd, deploy warns.
sync_timer() {
	local unit dir
	unit=$(timer_unit)
	dir=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
	if ! is_hostname "$HANGAR_PUBLIC_ADDR"; then
		[[ -f $dir/$unit.timer ]] || return 0
		systemctl --user disable --now "$unit.timer" >/dev/null 2>&1 || true
		rm -f "$dir/$unit.service" "$dir/$unit.timer"
		systemctl --user daemon-reload 2>/dev/null || true
		step "Removed timer $unit: --public-ip is no longer a domain"
		return 0
	fi
	if ! systemctl --user show-environment >/dev/null 2>&1; then
		printf 'hangar: no systemd user manager; run ./hangar refresh-ip -i %s yourself when the address changes\n' "$instance" >&2
		return 0
	fi
	mkdir -p "$dir"
	cat >"$dir/$unit.service" <<EOF
[Unit]
Description=rhodes-hangar: follow $HANGAR_PUBLIC_ADDR for instance $instance's live preview relay

[Service]
Type=oneshot
ExecStart="$ROOT/hangar" refresh-ip -i $instance
EOF
	cat >"$dir/$unit.timer" <<EOF
[Unit]
Description=rhodes-hangar: check $HANGAR_PUBLIC_ADDR every 5 minutes for instance $instance

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
EOF
	systemctl --user daemon-reload
	systemctl --user enable --now --quiet "$unit.timer"
	step "Timer $unit checks $HANGAR_PUBLIC_ADDR every 5 minutes (journalctl --user -u $unit.service)"
	if [[ $(loginctl show-user "$USER" -p Linger --value 2>/dev/null) != yes ]]; then
		printf '    It runs while %s is logged in; loginctl enable-linger %s keeps it running.\n' "$USER" "$USER"
	fi
}

boot_unit() { printf 'rhodes-hangar-up-%s' "$instance"; }

linger_note() {
	if [[ $(loginctl show-user "$USER" -p Linger --value 2>/dev/null) != yes ]]; then
		printf '    It runs once %s logs in; loginctl enable-linger %s makes that boot.\n' "$USER" "$USER"
	fi
}

# A systemd user service that runs `hangar up` at boot: the containers have no
# restart policy on purpose, as `up` also rewrites the relay's allow list for
# the addresses Docker hands out that time. It retries while Docker comes up.
install_service() {
	local unit file new
	unit=$(boot_unit)
	file=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$unit.service
	if ! systemctl --user show-environment >/dev/null 2>&1; then
		printf 'hangar: no systemd user manager; start the instance after a boot with ./hangar up -i %s\n' "$instance" >&2
		return 0
	fi
	new=$(
		cat <<EOF
[Unit]
Description=rhodes-hangar: start instance $instance
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=oneshot
ExecStart="$ROOT/hangar" up -i $instance
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
EOF
	)
	if [[ -f $file && $(<"$file") == "$new" ]] && systemctl --user is-enabled --quiet "$unit.service" 2>/dev/null; then
		return 0
	fi
	mkdir -p "$(dirname "$file")"
	printf '%s\n' "$new" >"$file"
	systemctl --user daemon-reload
	systemctl --user enable --quiet "$unit.service"
	step "Service $unit starts instance \"$instance\" at boot (./hangar service --uninstall -i $instance removes it)"
	linger_note
}

cmd_service() {
	need systemctl
	load_env
	local unit file
	unit=$(boot_unit)
	file=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$unit.service
	case $service_action in
	install)
		install_service
		printf 'Service %s is installed.\n' "$unit"
		;;
	uninstall)
		systemctl --user disable --quiet "$unit.service" 2>/dev/null || true
		rm -f "$file"
		systemctl --user daemon-reload
		printf 'Service %s removed; the instance keeps running and no longer starts at boot.\n' "$unit"
		;;
	status)
		if [[ ! -f $file ]]; then
			printf 'Service %s is not installed.\n' "$unit"
			return 0
		fi
		local at
		at=$(systemctl --user show "$unit.service" -p ExecMainExitTimestamp --value)
		printf 'Service %s: %s at boot; last run: %s\n' "$unit" \
			"$(systemctl --user is-enabled "$unit.service" 2>/dev/null || true)" \
			"${at:+$(systemctl --user show "$unit.service" -p Result --value) at $at}${at:-none since it was installed}"
		linger_note
		;;
	*) die "service takes --install, --uninstall or --status" ;;
	esac
}

main() {
	local cmd=${1:-}
	(($#)) && shift
	case $cmd in
	deploy) parse_opts "$@"; cmd_deploy ;;
	install-game) parse_opts "$@"; need docker curl jq; load_env; wait_boot; install_game ;;
	up) parse_opts "$@"; need docker; load_env; write_maa_profile; compose up -d; sync_relay ;;
	down) parse_opts "$@"; need docker; load_env; compose down ;;
	status) parse_opts "$@"; cmd_status ;;
	service) parse_opts "$@"; cmd_service ;;
	refresh-ip) parse_opts "$@"; cmd_refresh_ip ;;
	screen) parse_opts "$@"; need scrcpy adb; load_env
		[[ -n $SERIAL ]] || die "adb is not published; run ./hangar deploy -i $instance --adb-bind 127.0.0.1, or use the web console's live preview"
		# A recreated container leaves adb holding a dead connection to the same address.
		adb disconnect "$SERIAL" >/dev/null 2>&1 || true
		adb connect "$SERIAL" >/dev/null
		exec scrcpy -s "$SERIAL" --no-audio --no-clipboard-autosync --window-title="Arknights · $instance" ;;
	"" | -h | --help | help) usage ;;
	*) die "unknown command: $cmd (see: ./hangar help)" ;;
	esac
}

main "$@"
